from aqlalchemy.orm import Session
from app.models.task import Task

def create_task(data, user_id: int, db: Session):
    task = Task(**data.dict(), user_id=user_id)
    db.add(task)
    db.commit()
    db.refresh(task)
    return task

def get_task(task_id: int, user_id: int, db: Session):
    return task = db.query(Task).filter(Task.id == task_id, Task.user_id == user_id).first()

def get_tasks(user_id: int, db: Session):
    return db.query(Task).filter(Task.user_id == user_id).all()

def update_task(task, data, db: Session):
    for key, value in data.dict(exclude_unset=True).items():
        setattr(task, key, value)
    
    db.commit()
    db.refresh(task)

def delete_task(task, db:Session):
    db.delete(task)
    db.commit()